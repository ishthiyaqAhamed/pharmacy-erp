generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BRANCH_MANAGER
  PHARMACIST
  CASHIER
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String
  phone     String?
  createdAt DateTime @default(now())

  users User[]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CASHIER)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
}