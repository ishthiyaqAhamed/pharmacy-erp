generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BRANCH_MANAGER
  PHARMACIST
  CASHIER
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String
  phone     String?
  createdAt DateTime @default(now())

  users      User[]
  stockItems BranchStock[]
  sales      Sale[]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CASHIER)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
}

model Medicine {
  id           String   @id @default(cuid())
  name         String
  manufacturer String
  unit         String
  reorderLevel Int      @default(10)
  requiresRx   Boolean  @default(false)

  batches Batch[]
}

model Batch {
  id           String   @id @default(cuid())
  medicineId   String
  medicine     Medicine @relation(fields: [medicineId], references: [id])
  batchNumber  String
  expiryDate   DateTime
  costPrice    Decimal
  sellingPrice Decimal
  createdAt    DateTime @default(now())

  branchStock BranchStock[]
  saleItems   SaleItem[]

  @@unique([medicineId, batchNumber])
}

model BranchStock {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id])
  quantity  Int
  updatedAt DateTime @updatedAt

  @@unique([branchId, batchId])
}

model Sale {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  soldById    String
  totalAmount Decimal
  createdAt   DateTime @default(now())

  items SaleItem[]
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  batchId   String
  batch     Batch   @relation(fields: [batchId], references: [id])
  quantity  Int
  unitPrice Decimal
}